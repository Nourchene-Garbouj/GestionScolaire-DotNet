<Window x:Class="DS_.net.Views.CrudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Étudiants" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e2e">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,0,0,15">
            <TextBlock x:Name="TxtRole" Foreground="#aaaaaa" 
                       VerticalAlignment="Center" Margin="0,0,15,0"/>
            <Button Content="📝 Notes" Click="BtnNotes_Click"
        Background="#22c55e" Foreground="White"
        BorderThickness="0" Padding="10,5" Cursor="Hand" Margin="0,0,10,0"/>
            <Button Content="📊 Dashboard" Click="BtnDashboard_Click"
                    Background="#7c3aed" Foreground="White"
                    BorderThickness="0" Padding="10,5" Cursor="Hand"/>
        </StackPanel>

        <!-- Formulaire -->
        <Border Grid.Row="1" Background="#2e2e3e" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Nom" Foreground="#aaaaaa" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtNom" Height="32" Padding="6"
                             Background="#1e1e2e" Foreground="White" BorderBrush="#555"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Prénom" Foreground="#aaaaaa" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtPrenom" Height="32" Padding="6"
                             Background="#1e1e2e" Foreground="White" BorderBrush="#555"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="Date Naissance" Foreground="#aaaaaa" Margin="0,0,0,3"/>
                    <DatePicker x:Name="DpDateNaissance" Height="32"
                                Background="#1e1e2e" Foreground="Black"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="5">
                    <TextBlock Text="Classe" Foreground="#aaaaaa" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtClasse" Height="32" Padding="6"
                             Background="#1e1e2e" Foreground="White" BorderBrush="#555"/>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="5">
                    <Button x:Name="BtnAjouter" Content="➕ Ajouter" Height="32"
                            Background="#22c55e" Foreground="White"
                            BorderThickness="0" Padding="10,0" Cursor="Hand"
                            Click="BtnAjouter_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Liste des étudiants -->
        <DataGrid Grid.Row="2" x:Name="DgEtudiants"
                  Background="#2e2e3e" Foreground="White"
                  BorderBrush="#555" RowBackground="#2e2e3e"
                  AlternatingRowBackground="#252535"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="DgEtudiants_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#7c3aed"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*"/>
                <DataGridTextColumn Header="Date Naissance" Binding="{Binding DateNaissance, StringFormat=dd/MM/yyyy}" Width="*"/>
                <DataGridTextColumn Header="Classe" Binding="{Binding Classe}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Boutons actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="✏️ Modifier" Click="BtnModifier_Click"
                    Background="#f59e0b" Foreground="White"
                    BorderThickness="0" Padding="15,8" Margin="5,0"
                    Cursor="Hand"/>
            <Button Content="🗑️ Supprimer" Click="BtnSupprimer_Click"
                    Background="#ef4444" Foreground="White"
                    BorderThickness="0" Padding="15,8" Margin="5,0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>