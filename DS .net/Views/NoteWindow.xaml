<Window x:Class="DS_.net.Views.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Notes" Height="550" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e2e">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📝 Gestion des Notes"
                   FontSize="20" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#2e2e3e" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Étudiant" Foreground="#aaaaaa" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbEtudiant" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Matière" Foreground="#aaaaaa" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbMatiere" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="Note (0-20)" Foreground="#aaaaaa" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtNote" Height="32" Padding="6"
                             Background="#1e1e2e" Foreground="White" BorderBrush="#555"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="5">
                    <Button Content="➕ Ajouter" Height="32"
                            Background="#22c55e" Foreground="White"
                            BorderThickness="0" Padding="10,0"
                            Cursor="Hand" Click="BtnAjouterNote_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#2e2e3e" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Nouvelle Matière" Foreground="#aaaaaa" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtNomMatiere" Height="32" Padding="6"
                             Background="#1e1e2e" Foreground="White" BorderBrush="#555"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Coefficient" Foreground="#aaaaaa" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtCoeff" Height="32" Padding="6"
                             Background="#1e1e2e" Foreground="White" BorderBrush="#555"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="5">
                    <Button Content="➕ Matière" Height="32"
                            Background="#7c3aed" Foreground="White"
                            BorderThickness="0" Padding="10,0"
                            Cursor="Hand" Click="BtnAjouterMatiere_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="3" x:Name="DgNotes"
                  Background="#2e2e3e" Foreground="White"
                  BorderBrush="#555" RowBackground="#2e2e3e"
                  AlternatingRowBackground="#252535"
                  GridLinesVisibility="Horizontal"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#7c3aed"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Étudiant" Binding="{Binding Etudiant.NomComplet}" Width="*"/>
                <DataGridTextColumn Header="Matière" Binding="{Binding Matiere.Nom}" Width="*"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Valeur}" Width="*"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>