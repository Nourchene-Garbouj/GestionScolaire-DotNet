<Window x:Class="DS_.net.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion" Height="420" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#1e1e2e">
        <StackPanel VerticalAlignment="Center" Margin="40">

            <TextBlock Text="🎓 Gestion Scolaire"
                       FontSize="22" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBlock Text="Login" Foreground="#aaaaaa" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLogin" Height="35" Padding="8"
                     Background="#2e2e3e" Foreground="White"
                     BorderBrush="#7c3aed" CaretBrush="White" FontSize="14"/>

            <TextBlock Text="Mot de passe" Foreground="#aaaaaa" Margin="0,15,0,5"/>
            <PasswordBox x:Name="TxtPassword" Height="35" Padding="8"
                         Background="#2e2e3e" Foreground="White"
                         BorderBrush="#7c3aed" FontSize="14"/>

            <TextBlock x:Name="TxtError" Foreground="#ff6b6b"
                       Margin="0,10,0,0" HorizontalAlignment="Center"/>

            <Button Content="Se connecter" Height="40" Margin="0,20,0,0"
                    Background="#7c3aed" Foreground="White"
                    FontSize="14" FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand" Click="BtnLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>